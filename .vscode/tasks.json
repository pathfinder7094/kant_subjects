{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "uv: debug check index",
            "type": "process",
            "command": "uv",
            "args": [
                "run",
                "--frozen",
                "--with",
                "debugpy",
                "python",
                "${workspaceFolder}\\.vscode\\debug.py",
                "5678",
                "${workspaceFolder}\\main.py",
                "check",
                "index"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "uv-debug",
                "pattern": {
                    "regexp": "^(DEBUGPY_STARTING|DEBUGPY_READY)$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^DEBUGPY_STARTING$",
                    "endsPattern": "^DEBUGPY_READY$"
                }
            }
        },
